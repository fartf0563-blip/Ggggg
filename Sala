name: Build APK
on:
  push:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.7
      - name: Unpack app
        run: |
          echo "" | base64 -d > p.zip
          unzip p.zip
      - name: Build
        working-directory: FreeFlow
        run: gradle assembleDebug
      - name: Publish APK
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release create v${{ github.run_number }} FreeFlow/app/build/outputs/apk/debug/app-debug.apk --repo ${{ github.repository }} --title "Free Flow" --notes "Install app-debug.apk"

